# vc-gate 설정 — root 소유 0600. 이 파일의 EXPECTED_SCOPE 변경은 change record 필수.
HOST_ID={{ host_id }}
COUNTERPARTY_HOST_ID={{ counterparty_host_id | default('aws-standby-01') }}
NETWORK={{ network }}
FEE_RECIPIENT={{ fee_recipient }}
EXPECTED_SCOPE={{ expected_scope }}
BN_URL=http://127.0.0.1:5052
EXPECTED_GENESIS_VALIDATORS_ROOT={{ genesis_validators_root }}
PUBKEYS_FILE=/etc/ethereum/failover/expected-pubkeys.txt
CHECKLIST_FILE=/etc/ethereum/failover/checklist.txt
TOKEN_FILE=/etc/ethereum/failover/approval.token
SEALED_MARKER=/etc/ethereum/failover/SEALED
VC_DATADIR={{ vc_datadir }}
DP_UNIT_PATHS=/usr/local/lib/systemd/system/lighthouse-validator.service
SP_IMPORT_MARKER=/etc/ethereum/failover/sp-import-approved
SP_STATE_OWNER_EXPECTED=root
SP_DB_OWNER_EXPECTED=lighthouse-validator
ABSENCE_EVIDENCE=/var/lib/ethereum-maintenance/evidence/current-absence.json
EVIDENCE_ROOT=/var/lib/ethereum-maintenance/evidence
EVIDENCE_STORE_HELPER=/usr/local/sbin/vc-evidence-store
EVIDENCE_OWNER_EXPECTED=root
ABSENCE_MAX_AGE_MIN=30
MIN_ABSENT_EPOCHS=3
GATE_LOG=/var/lib/ethereum-maintenance/evidence/vc-gate.log
FENCE_EVIDENCE=/etc/ethereum/failover/source-fence.json
FENCE_MAX_AGE_MIN=15
LEASE_TIMER=vc-lease.timer
LEASE_MAX_TOKEN_HOURS=168
# Python 3 helper: 안전 입력과 absence checksum의 exact bytes를 고정한다.
INPUT_SNAPSHOT_HELPER=/usr/local/sbin/vc-input-snapshot
INPUT_SNAPSHOT_BASE=/run/ethereum-vc-gate
INPUT_OWNER_EXPECTED=root
