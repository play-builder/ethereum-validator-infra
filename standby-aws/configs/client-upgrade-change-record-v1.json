{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "client-upgrade-change-record-v1.json",
  "title": "Client Upgrade Change Record v1",
  "description": "Two-person approved, lock-bound, standby-first client upgrade authority. The root copy under shared/schemas is the only edit authority; package copies are generated byte-identical mirrors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "network",
    "lock_sha256",
    "clients",
    "approvals",
    "windows",
    "standby_soak",
    "standby_evidence_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "client-upgrade-change-record-v1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^CR-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
    },
    "network": {
      "const": "hoodi"
    },
    "lock_sha256": {
      "description": "SHA-256 of the reviewed root client-release-lock.json bytes; must equal source_lock_sha256 of the generated snapshot consumed at validation time.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "clients": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nethermind", "lighthouse"],
      "properties": {
        "nethermind": { "$ref": "#/$defs/client_change" },
        "lighthouse": { "$ref": "#/$defs/client_change" }
      }
    },
    "approvals": {
      "description": "Exactly two approvals by distinct operators.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operator", "approved_at"],
        "properties": {
          "operator": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]{0,63}$"
          },
          "approved_at": { "$ref": "#/$defs/rfc3339_utc" }
        }
      }
    },
    "windows": {
      "description": "Site maintenance windows. The AWS window must start at or after the AWS Standby window ends (standby-first); windows must never overlap.",
      "type": "object",
      "additionalProperties": false,
      "required": ["standby", "aws"],
      "properties": {
        "standby": { "$ref": "#/$defs/window" },
        "aws": { "$ref": "#/$defs/window" }
      }
    },
    "standby_soak": {
      "description": "Approved canary soak interval; must lie inside windows.standby and span exactly 3600 seconds (13 samples at 300-second spacing).",
      "$ref": "#/$defs/window"
    },
    "standby_evidence_sha256": {
      "description": "SHA-256 of the exact AWS Standby canary soak evidence file bytes required before the AWS window may open.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "rfc3339_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "ends_at"],
      "properties": {
        "starts_at": { "$ref": "#/$defs/rfc3339_utc" },
        "ends_at": { "$ref": "#/$defs/rfc3339_utc" }
      }
    },
    "client_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_version", "after_version"],
      "properties": {
        "before_version": { "$ref": "#/$defs/semver" },
        "after_version": {
          "description": "Must equal the pinned version in the bound client release lock.",
          "$ref": "#/$defs/semver"
        }
      }
    },
    "standby_evidence": {
      "title": "Client Upgrade AWS Standby Evidence v1",
      "description": "Canary soak evidence produced on AWS Standby; consumed in aws mode only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_id",
        "lock_sha256",
        "site",
        "healthy",
        "vc_sealed",
        "vc_key_absent",
        "soak_started_at",
        "soak_completed_at",
        "samples"
      ],
      "properties": {
        "schema_version": { "const": "client-upgrade-standby-evidence-v1" },
        "record_id": { "type": "string", "pattern": "^CR-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
        "lock_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "site": { "const": "standby" },
        "healthy": { "type": "boolean" },
        "vc_sealed": { "type": "boolean" },
        "vc_key_absent": { "type": "boolean" },
        "soak_started_at": { "$ref": "#/$defs/rfc3339_utc" },
        "soak_completed_at": { "$ref": "#/$defs/rfc3339_utc" },
        "samples": {
          "description": "Exactly 13 strictly increasing RFC3339 UTC samples at exact 300-second spacing from soak_started_at to soak_completed_at.",
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": { "$ref": "#/$defs/rfc3339_utc" }
        }
      }
    }
  }
}
