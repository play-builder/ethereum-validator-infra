# lab.env.example — 실습 공통 환경 변수

# 사용법 
#   cp reference/lab.env.example ./lab.env
#   "${EDITOR:-vi}" ./lab.env         ← [조직·Gmail 기준값]과 [공통] 기본값을 검토
#   source ./lab.env                  ← 새 터미널을 열 때마다 다시 source

## ── [조직·Gmail 기준값 — 다른 환경에서는 이 두 값부터 변경] ────────────────
# LAB_ORG_SLUG는 AWS 계정·Identity 관리자 이름의 접두사이며 최대 17자다.
# GMAIL_BASE_EMAIL은 +alias가 없는 실제 Gmail 기본 주소다.

## ── [조직·Gmail 기준값 — 다른 환경에서는 이 두 값부터 변경] ────────────────
# LAB_ORG_SLUG는 AWS 계정·Identity 관리자 이름의 접두사이며 최대 17자다.
# GMAIL_BASE_EMAIL은 +alias가 없는 실제 Gmail 기본 주소다.
export LAB_ORG_SLUG="${LAB_ORG_SLUG:-playbuilder}"
export GMAIL_BASE_EMAIL="${GMAIL_BASE_EMAIL:-dev.playbuilder47@gmail.com}"

if ! [[ "${LAB_ORG_SLUG}" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  echo "[lab.env] LAB_ORG_SLUG는 소문자·숫자·단일 하이픈만 사용할 수 있습니다." >&2
  return 1 2>/dev/null || exit 1
fi
if (( ${#LAB_ORG_SLUG} > 17 )); then
  echo "[lab.env] LAB_ORG_SLUG는 17자 이하여야 합니다. Permission Set 이름은 AWS 제한인 32자를 넘을 수 없습니다." >&2
  return 1 2>/dev/null || exit 1
fi
if ! [[ "${GMAIL_BASE_EMAIL}" =~ ^[A-Za-z0-9]([A-Za-z0-9.]*[A-Za-z0-9])?@gmail\.com$ ]]; then
  echo "[lab.env] GMAIL_BASE_EMAIL은 +alias가 없는 gmail.com 기본 주소여야 합니다." >&2
  return 1 2>/dev/null || exit 1
fi

_gmail_local="${GMAIL_BASE_EMAIL%@*}"
_gmail_domain="${GMAIL_BASE_EMAIL#*@}"

export MANAGEMENT_ACCOUNT_NAME="${LAB_ORG_SLUG}-management"
export MANAGEMENT_ROOT_EMAIL="${GMAIL_BASE_EMAIL}"
export IDENTITY_ACCOUNT_NAME="${LAB_ORG_SLUG}-identity"
export IDENTITY_ACCOUNT_OWNER_EMAIL="${_gmail_local}+identity_root@${_gmail_domain}"
export WORKLOAD_ACCOUNT_NAME="hoodi-testnet-dev"
export WORKLOAD_ACCOUNT_OWNER_EMAIL="${_gmail_local}+workload@${_gmail_domain}"

export IDENTITY_ADMIN_NAME="${LAB_ORG_SLUG}-identity-admin"
export IDENTITY_ADMIN_USER="${IDENTITY_ADMIN_NAME}"
export IDENTITY_ADMIN_AWS_PROFILE="${IDENTITY_ADMIN_NAME}"
export IDENTITY_ADMIN_PERMISSION_SET="${LAB_ORG_SLUG}-identity-admin"
export IDENTITY_ADMIN_EMAIL="${_gmail_local}+identity@${_gmail_domain}"
export PLATFORM_BOOTSTRAP_AWS_PROFILE="${LAB_ORG_SLUG}-platform-bootstrap"

# 같은 역할은 AWS Identity Center, SNS와 GitHub에서 같은 Gmail 별칭을 사용한다.
export OP1_EMAIL="${_gmail_local}+testnet_op1@${_gmail_domain}"
export OP2_EMAIL="${_gmail_local}+testnet_op2@${_gmail_domain}"
export SECURITY_REVIEWER_EMAIL="${_gmail_local}+testnet_sec@${_gmail_domain}"
unset _gmail_local _gmail_domain

## ── [공통 — 기본값 유지 가능] ─────────────────────────────────────────────
export AWS_REGION="ap-northeast-2"                    # primary node를 배포할 AWS Region
export WORKLOAD_ACCOUNT_ID=""                         # workload AWS account의 12자리 account ID
export KEY_NAME="eth-failover-hoodi"                  # Terraform key_pair_name이 참조할 EC2 key pair 이름
export KEY_FILE="$HOME/.ssh/eth-failover-hoodi.pem"   # 개인키 로컬 경로 (백업 금지)
# IAM Identity Center 운영자 두 명과 각 Permission Set 이름
export OP1_SSO_USER="${OP1_SSO_USER:-testnet_operator_01}" # 만드는 사람 (IdC 사용자명)
export OP2_SSO_USER="${OP2_SSO_USER:-testnet_operator_02}" # 승인하는 사람
export OP1_PERMISSION_SET="testnet_operator_01_builder" # Permission Set 이름 → tfvars·KMS key policy가 소비
export OP2_PERMISSION_SET="testnet_operator_02_approver"
export OP1_AWS_PROFILE="hoodi-testnet-dev-builder"      # 로컬 운영·조회용 SSO label — Terraform apply 주체가 아님
export OP2_AWS_PROFILE="hoodi-testnet-dev-approver"     # AWS 상태를 독립 확인하는 read/audit SSO label
export LAB_AWS_PROFILE="${OP1_AWS_PROFILE}"             # 운영 조회 명령용 alias; Terraform 배포에는 사용하지 않음

## ── [AWS standby runtime — 리소스가 확정되면 기록] ────────────────
export STANDBY_AWS_REGION="eu-central-1"
export STANDBY_NODE_IP=""                 # AWS 타 리전 standby EC2의 공인 IPv4
export STANDBY_INSTANCE_ID=""              # AWS API로 확인한 standby EC2 instance ID
export STANDBY_SECURITY_GROUP_ID=""        # AWS API로 확인한 standby Security Group ID
export STANDBY_ADMIN_CIDR=""              # standby 관리 접속을 허용할 공인 IPv4 한 개의 /32
export STANDBY_NODE_ALIAS="aws-standby-01"  # inventory에 적는 Standby EC2 이름 — 기본값 유지 가능
export OPERATOR="ethops"                  # standby 호스트의 운영 계정 이름 — 기본값 유지 가능
export REFERENCE_BN_URL=""                # 주노드와 다른 운영 주체의 독립 Beacon API 주소

## ── [Terraform CI/CD — 운영 배포 고정값] ─────────────────────────────────
# Terraform 인프라 변경은 로컬 AWS SSO profile이 아니라 GitHub Actions에서 수행한다.
# PlanRole은 plan만 만들고, protected Environment 승인 뒤의 TerraformApplyRole만 exact plan을 적용한다.
## ── [GitHub 계정 — 이름 규칙: ${GITHUB_ADMIN_ACCOUNT}-역할] ──────────
# GitHub username은 전 세계에서 유일하므로 역할 계정은 관리 계정 이름을
# 접두로 붙여 만든다. 예: play-builder와 play-builder-op1.
export GITHUB_ADMIN_ACCOUNT=""                         # organization을 만든 본인 GitHub 계정
export GITHUB_OPERATOR1_ACCOUNT=""                     # 배포 담당자 = ${GITHUB_ADMIN_ACCOUNT}-op1
export GITHUB_OPERATOR2_ACCOUNT=""                     # 배포 승인자 = ${GITHUB_ADMIN_ACCOUNT}-op2
export GITHUB_SECURITY_ACCOUNT=""                      # 보안 검토자 = ${GITHUB_ADMIN_ACCOUNT}-sec

export GITHUB_REPOSITORY=""                            # 검증한 OWNER/REPOSITORY 전체 이름
export GITHUB_REPOSITORY_OWNER_ID=""                   # GitHub API의 numeric owner.id; immutable OIDC subject 입력
export GITHUB_REPOSITORY_ID=""                         # GitHub API의 numeric repository id; immutable OIDC subject 입력
export TF_DEPLOY_ENVIRONMENT="hoodi-testnet-dev"
export TF_PLAN_ROLE_NAME="hoodi-testnet-dev-TerraformPlanRole"    # bootstrap이 만드는 Terraform plan role 이름
export TF_APPLY_ROLE_NAME="hoodi-testnet-dev-TerraformApplyRole"  # bootstrap이 만드는 Terraform apply role 이름

## ── [자동 전환 — 수정 금지: 프로파일이 생기면 그때부터 그것을 쓴다] ────────
# builder profile이 AWS config에 있으면 source할 때 운영 profile로 선택한다.
# 로그인 session 발급은 별도로 aws sso login을 실행해야 한다.
# [파생] 섹션보다 반드시 앞에 있어야 ACCT가 builder 프로파일에서 계산된다.
_lab_profile_ready=0
if grep -qE "^\[profile ${LAB_AWS_PROFILE}\]" "${AWS_CONFIG_FILE:-$HOME/.aws/config}" 2>/dev/null; then
  export AWS_PROFILE="${LAB_AWS_PROFILE}"
  _lab_profile_ready=1
fi

## ── [파생 — 수정 금지: 저장소 루트] ─────────────────────────────────
# 여러 스크립트가 ${PACKAGE_ROOT}로 현재 저장소 루트를 참조한다.
# 저장소가 된 뒤에는 git이 알려 주고, 그 전에는 lab.env가 있는 위치를 위로 올라가며 찾는다.
_p="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "${_p}" ]; then
  _p="$PWD"
  while [ "${_p}" != "/" ] && [ ! -f "${_p}/lab.env" ]; do _p="$(dirname "${_p}")"; done
fi
if [ -n "${_p}" ] && { [ -f "${_p}/lab.env" ] || [ -f "${_p}/lab.env.example" ]; }; then
  export PACKAGE_ROOT="${_p}"
fi
unset _p

## ── [파생 — 수정 금지: 로그인 계정과의 불일치를 차단] ──────────────────────
export ACCT="$(aws sts get-caller-identity --query Account --output text 2>/dev/null || true)"
export STATE_BUCKET="hoodi-testnet-dev-tfstate-${ACCT}"  # 현재 account ID로 파생한 Terraform state bucket 이름
# profile을 만들기 전에는 ACCT가 비는 것이 정상이므로 조용히 넘어간다.
# 이 판정은 config 파일에 profile 블록이 실제로 있는지(_lab_profile_ready)로만 한다.
# AWS_PROFILE 환경 변수는 셸이나 이전 세션에서 물려받았을 수 있어 기준으로 쓰지 않는다.
if [ -z "${ACCT}" ] && [ "${_lab_profile_ready}" = "1" ]; then
  echo "[lab.env] ${AWS_PROFILE} session이 없습니다 — aws sso login --profile ${AWS_PROFILE} 실행 후 다시 source" >&2
fi
unset _lab_profile_ready

## ── [runtime 값 — 권위 있는 API 조회 뒤 기록] ────────────────────────
# read-only AWS API audit helper가 아래 runtime identity를 기록한다:
# export TOPIC_ARN="arn:aws:sns:ap-northeast-2:123456789012:eth-failover-hoodi-alerts"
# export NODE_IP="54.180.12.34"          # exact tagged EIP; globally routable IPv4 검증 후 기록
# export INSTANCE_ID="i-0abc12345def67890" # exact tagged non-terminated instance 1개
# export PARAM_PREFIX="/eth-staking/hoodi" # exact tagged SSM parameter 3개의 공통 prefix
# export PUBKEY="0xa5e870...9e56"          # deposit data와 일치하는 validator public key
# export DEPOSIT_TX="0x4d1f...5e90"         # Hoodi deposit transaction hash
# export HOODI_DEPOSIT_CONTRACT="0x0000...0000" # 공식 Launchpad와 대조한 deposit contract address
# export EXPLORER_URL="https://light-hoodi.beaconcha.in/validator/0xa5e870...9e56"
# export VALIDATOR_INDEX="1049216"          # local Beacon API가 반환한 validator index
# export RECOVERY_KEY_ARN="arn:aws:kms:eu-central-1:123456789012:key/..."  # recovery KMS key의 exact ARN
# export VALSTATE_VOL_ID="vol-0f34ab12cd56ef789"  # validator state를 보존하는 EBS volume ID
